            "collection-title": {
              "type": "collection-title",
              "settings": {
                "type_preset": "rte",
                "width": "fit-content",
                "alignment": "left",
                "background": true,
                "background_color": "#ffffff",
                "padding-block-start": 4,
                "padding-block-end": 4,
                "padding-inline-start": 8,
                "padding-inline-end": 8
              }
            }
          }
        }
      },
      "block_order": [
        "cat_header"
      ],
      "name": "Shop by category",
      "settings": {
        "collection_list": [
